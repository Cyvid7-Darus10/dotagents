{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.env)",
      "Read(**/credentials*)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/secrets*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.env)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)",
      "Bash(curl * -d *)",
      "Bash(curl * --data *)",
      "Bash(curl * -F *)",
      "Bash(wget --post-data *)",
      "Bash(git remote add *)",
      "Bash(npm publish*)",
      "Bash(nc *)",
      "Bash(netcat *)"
    ]
  }
}
